{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Omega Notes",
  "version": "2.7.2",
  "identifier": "com.nightmin.omega-notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ω Notes",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NightMin2002/omega-notes/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/NightMin2002/omega-notes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NDEyN0Q0OTgzNzREMUMKUldRY1RUZVkxQ2RCWnVoN08zTy81SklDYkFvNkNFUnpwVzJ6cHB1MWRhcEh2TFNBMzdRRGorWlYK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
